---
import Base from '../layouts/Base.astro'
import { SetWall } from '../components/SetWall.tsx'
import { Recent } from '../components/Recent.tsx'
import { readData } from '../lib/data.ts'
import { url } from '../lib/paths.ts'
import type { SetSummary } from '../lib/types.ts'

const sets = await readData<SetSummary[]>('sets.json')

// The wall opens on Releases, so the server-rendered seed has to be that view's
// first page. Seeding from the whole catalogue would leave it mostly filtered
// away before the rest arrives.
const RELEASES = ['expansion', 'core', 'masters', 'draft_innovation', 'commander', 'starter']
const releases = sets.filter((s) => !s.digital && RELEASES.includes(s.type))
const paper = sets.filter((s) => !s.digital)
const printings = paper.reduce((n, s) => n + s.count, 0)
const paperCount = paper.length
---

<Base
  title="chatmtg — importable card lists for every Magic set"
  description="Pick a Magic: The Gathering set or Secret Lair drop and get its card list as a ManaBox CSV, a Moxfield or Archidekt import, or a plain text decklist."
>
  <p slot="masthead" class="sub mono" style="font-size:11px">
    {paperCount.toLocaleString()} sets · {printings.toLocaleString()} cards
  </p>

  <section class="wrap">
    <Recent client:load />
    <SetWall
      client:load
      sets={releases.slice(0, 60)}
      total={paperCount}
      seedCount={releases.length}
      base={url()}
    />
  </section>
</Base>
