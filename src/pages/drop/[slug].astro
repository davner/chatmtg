---
import Base from '../../layouts/Base.astro'
import { SetExporter } from '../../components/SetExporter.tsx'
import { readData } from '../../lib/data.ts'
import { url } from '../../lib/paths.ts'
import type { DropSummary } from '../../lib/types.ts'

export async function getStaticPaths() {
  const drops = await readData<DropSummary[]>('drops.json')
  return drops.map((drop) => ({ params: { slug: drop.slug }, props: { drop } }))
}

const { drop } = Astro.props
---

<Base
  title={`${drop.name} — Secret Lair card list | chatmtg`}
  description={`The ${drop.count} cards in the ${drop.name} Secret Lair drop, with the right finish, exportable as a ManaBox CSV or a plain text decklist.`}
>
  <section class="wrap">
    <div class="pagehead">
      <div>
        <p class="crumb">
          <a href={url()}>The Wall</a> / <a href={url("set/sld/")}>SLD</a> / Drop
        </p>
        <h2 class="pagetitle">{drop.name}</h2>
        <div class="meta">
          <div><span class="field">Released</span><span class="v">{drop.released}</span></div>
          <div><span class="field">Cards</span><span class="v">{drop.count}</span></div>
          <div>
            <span class="field">Finish</span>
            <span class="v">
              <span class="finflag">{drop.finishLabel}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {drop.provenance && (
    <section class="wrap">
      <div class="panelbox sourced">
        <div class="holo" />
        <div class="strucknote">
          <strong>Sourced</strong>
          <span>
            MTGJSON has not published this deck yet, so the card list comes from{' '}
            <a href={drop.provenance.url}>{drop.provenance.name}</a>, retrieved{' '}
            {drop.provenance.retrieved}. All {drop.count} cards are correct.
            {drop.substituted ? (
              <>
                {' '}<strong class="inlineflag">{drop.substituted} printings are stand-ins</strong> —
                those cards' actual printings in this product are not catalogued by Scryfall or
                MTGJSON yet, so an older printing is used. The card is right; the exact version
                is not. Rows affected are marked SUB below.
              </>
            ) : null}
          </span>
        </div>
      </div>
    </section>
  )}

  {
    drop.incomplete ? (
      <section class="wrap">
        <div class="panelbox struck">
          <div class="strucknote">
            <strong>Struck</strong>
            <span>
              {drop.incomplete} Until it does, there is nothing here to export. This drop is
              listed rather than hidden so you can tell it exists and that the gap is
              upstream, not a search that failed.
            </span>
          </div>
        </div>
      </section>
    ) : (
      <section class="wrap">
        <div class="opened">
          <SetExporter
            client:load
            source={{
              kind: 'drop',
              url: url(`data/drops/${drop.slug}.json`),
              setCode: 'sld',
              setName: 'Secret Lair Drop',
            }}
            binder={drop.name}
            filename={drop.slug}
          />
        </div>
      </section>
    )
  }
</Base>
